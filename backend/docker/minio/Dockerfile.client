FROM debian:bookworm-slim

ARG TARGETARCH
ARG MC_RELEASE=RELEASE.2025-08-13T08-35-41Z

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl; \
    rm -rf /var/lib/apt/lists/*; \
    case "${TARGETARCH}" in \
      amd64) mc_arch="amd64" ;; \
      arm64) mc_arch="arm64" ;; \
      *) echo "Unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    asset="mc.linux-${mc_arch}.${MC_RELEASE}"; \
    release_url="https://github.com/minio/mc/releases/download/${MC_RELEASE}"; \
    curl --fail --location --retry 3 --output "/tmp/${asset}" "${release_url}/${asset}"; \
    curl --fail --location --retry 3 --output "/tmp/${asset}.sha256sum" "${release_url}/${asset}.sha256sum"; \
    cd /tmp; \
    expected_hash="$(cut -d ' ' -f 1 "${asset}.sha256sum")"; \
    echo "${expected_hash}  ${asset}" | sha256sum --check -; \
    install -m 0755 "${asset}" /usr/bin/mc; \
    rm -f "/tmp/${asset}" "/tmp/${asset}.sha256sum"

ENTRYPOINT ["/usr/bin/mc"]
