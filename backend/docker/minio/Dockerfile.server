FROM debian:bookworm-slim

ARG TARGETARCH
ARG MINIO_RELEASE=RELEASE.2025-09-07T16-13-09Z

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl; \
    rm -rf /var/lib/apt/lists/*; \
    case "${TARGETARCH}" in \
      amd64) minio_arch="amd64" ;; \
      arm64) minio_arch="arm64" ;; \
      *) echo "Unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    asset="minio.linux-${minio_arch}.${MINIO_RELEASE}"; \
    release_url="https://github.com/minio/minio/releases/download/${MINIO_RELEASE}"; \
    curl --fail --location --retry 3 --output "/tmp/${asset}" "${release_url}/${asset}"; \
    curl --fail --location --retry 3 --output "/tmp/${asset}.sha256sum" "${release_url}/${asset}.sha256sum"; \
    cd /tmp; \
    expected_hash="$(cut -d ' ' -f 1 "${asset}.sha256sum")"; \
    echo "${expected_hash}  ${asset}" | sha256sum --check -; \
    install -m 0755 "${asset}" /usr/local/bin/minio; \
    rm -f "/tmp/${asset}" "/tmp/${asset}.sha256sum"

EXPOSE 9000 9001
ENTRYPOINT ["/usr/local/bin/minio"]
CMD ["server", "/data", "--console-address", ":9001"]
